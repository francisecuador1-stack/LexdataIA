{
  "name": "lexdata-ia",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @lexdata/api exec prisma generate",
    "db:apply": "bash scripts/db-apply.sh",
    "db:seed": "pnpm --filter @lexdata/api exec tsx prisma/seed.ts",
    "db:reset": "bash scripts/db-reset.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
