{
  "name": "lexdata-ia",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @lexdata/api prisma generate",
    "db:push": "pnpm --filter @lexdata/api prisma db push",
    "db:reset": "pnpm --filter @lexdata/api prisma migrate reset",
    "db:migrate": "pnpm --filter @lexdata/api prisma migrate dev"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
