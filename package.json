{
  "name": "lexdata-ia",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:apply": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/migrations/20260912000000_initial_schema.sql",
    "db:seed": "tsx apps/api/prisma/seed.ts",
    "db:reset": "psql \"$DATABASE_URL\" -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && pnpm db:apply && pnpm db:generate && pnpm db:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
