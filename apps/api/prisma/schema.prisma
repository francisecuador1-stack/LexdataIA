// ════════════════════════════════════════════════════════════
// 6. BÓVEDA DE EVIDENCIAS (INV-3) Y DOCUMENTOS
// ════════════════════════════════════════════════════════════

model Evidencia {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  nombre         String
  tipoDocumento  String   @map("tipo_documento")
  formato        String?
  dimensionId    String?  @map("dimension_id") @db.Uuid
  controlId      String?  @map("control_id") @db.Uuid
  fase           Int?     @db.SmallInt
  storageKey     String   @map("storage_key")
  mime           String?
  sizeBytes      Int      @map("size_bytes")
  hashSha256     String   @map("hash_sha256")
  prevHash       String?  @map("prev_hash")
  chainIndex     Int      @default(0) @map("chain_index")
  cargadoPorId   String   @map("cargado_por_id") @db.Uuid
  cargadoPorArea String?  @map("cargado_por_area")
  retencionHasta DateTime @map("retencion_hasta") // created_at + 5 años (INV-3)
  createdAt      DateTime @default(now()) @map("created_at")
  // APPEND ONLY — no updatedAt (INV-3)

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  cargadoPor User     @relation("creadoPor", fields: [cargadoPorId], references: [id])
  control    Control? @relation("controlEvidencias", fields: [controlId], references: [id])

  @@index([tenantId])
  @@index([hashSha256])
  @@map("evidencias")
}

model Documento {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  tipo          String
  titulo        String
  version       String    @default("1.0")
  estado        String    @default("PENDIENTE") // PENDIENTE|GENERAR|BORRADOR|APROBAR|APROBADO
