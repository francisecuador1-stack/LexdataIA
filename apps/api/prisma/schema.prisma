  pdfStorageKey String?   @map("pdf_storage_key")
  hashSha256    String?   @map("hash_sha256")
  generadoPor   ActorType @default(SISTEMA) @map("generado_por")
  aprobadoPor   String?   @map("aprobado_por") @db.Uuid
  aprobadoAt    DateTime? @map("aprobado_at")
  firmaId       String?   @map("firma_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  firmas Firma[]

  @@index([tenantId])
  @@map("documentos")
}

model Firma {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  documentoId       String   @map("documento_id") @db.Uuid
  usuarioId         String   @map("usuario_id") @db.Uuid
  metodo            String // PIN | BIOMETRIA | CERT_DIGITAL
  declaracionJurada Boolean  @default(false) @map("declaracion_jurada")
  ip                String?
  userAgent         String?  @map("user_agent")
  hashFirma         String   @map("hash_firma")
  firmadoAt         DateTime @default(now()) @map("firmado_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  documento Documento @relation(fields: [documentoId], references: [id])
  usuario   User      @relation(fields: [usuarioId], references: [id])

  @@index([tenantId])
  @@map("firmas")
}

model SolicitudFirma {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tipo        String
  entidad     String
  entidadId   String    @map("entidad_id") @db.Uuid
  motivo      String    @db.Text
