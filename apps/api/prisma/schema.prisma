// 9. CAPACITACIONES
// ════════════════════════════════════════════════════════════

model Curso {
  id            String  @id @default(uuid()) @db.Uuid
  codigo        String  @unique
  titulo        String
  descripcion   String  @db.Text
  nivel         String // BASICO | INTERMEDIO | AVANZADO
  categoria     String
  baseNormativa String  @map("base_normativa")
  duracionMin   Int     @map("duracion_min")
  numPreguntas  Int     @default(10) @map("num_preguntas")
  activo        Boolean @default(true)

  preguntas     CursoPregunta[]
  inscripciones Inscripcion[]
  evaluaciones  Evaluacion[]

  @@map("cursos")
}

model CursoPregunta {
  id          String  @id @default(uuid()) @db.Uuid
  cursoId     String  @map("curso_id") @db.Uuid
  orden       Int
  enunciado   String  @db.Text
  opciones    Json // [{text: string}]
  correcta    Int     @db.SmallInt
  explicacion String? @db.Text

  curso Curso @relation(fields: [cursoId], references: [id])

  @@map("curso_preguntas")
}

model Inscripcion {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  cursoId       String   @map("curso_id") @db.Uuid
  personaNombre String   @map("persona_nombre")
  personaEmail  String   @map("persona_email")
  estado        String   @default("INSCRITO")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  curso  Curso  @relation(fields: [cursoId], references: [id])

  @@index([tenantId])
  @@map("inscripciones")
}

model Evaluacion {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  cursoId       String   @map("curso_id") @db.Uuid
  personaNombre String   @map("persona_nombre")
  puntaje       Int      @db.SmallInt
  aprobado      Boolean // puntaje >= 70 (RN-801)
  fecha         DateTime @default(now())
  intento       Int      @default(1)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  curso       Curso        @relation(fields: [cursoId], references: [id])
  certificado Certificado?

  @@index([tenantId])
  @@map("evaluaciones")
}

model Certificado {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  evaluacionId  String   @unique @map("evaluacion_id") @db.Uuid
  codigo        String   @unique
  hashSha256    String   @map("hash_sha256")
  pdfStorageKey String?  @map("pdf_storage_key")
  emitidoAt     DateTime @default(now()) @map("emitido_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  evaluacion Evaluacion @relation(fields: [evaluacionId], references: [id])

  @@map("certificados")
}

// ════════════════════════════════════════════════════════════
// 10. PORTAL DEL CLIENTE Y COTIZACIÓN
// ════════════════════════════════════════════════════════════

model PimsModulo {
  id            String @id @default(uuid()) @db.Uuid
  numero        Int    @db.SmallInt // 0..10
  titulo        String
  descripcion   String @db.Text
  baseNormativa String @map("base_normativa")

  preguntas PimsPregunta[]

  @@unique([numero])
  @@map("pims_modulos")
}

model PimsPregunta {
  id        String  @id @default(uuid()) @db.Uuid
  moduloId  String  @map("modulo_id") @db.Uuid
  orden     Int
  enunciado String  @db.Text
  nota      String? @db.Text

  modulo     PimsModulo      @relation(fields: [moduloId], references: [id])
  respuestas PimsRespuesta[]

  @@map("pims_preguntas")
}

model PimsRespuesta {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  preguntaId   String        @map("pregunta_id") @db.Uuid
  respuesta    RespuestaPIMS
  respondidoAt DateTime      @default(now()) @map("respondido_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  pregunta PimsPregunta @relation(fields: [preguntaId], references: [id])

  @@unique([tenantId, preguntaId])
  @@index([tenantId])
  @@map("pims_respuestas")
}

model SolicitudRegistro {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String?         @map("tenant_id") @db.Uuid
  datos                Json // respuestas crudas S1..S7
  pdScore              Int?            @map("pd_score")
  nivelRiesgo          NivelRiesgo?    @map("nivel_riesgo")
  caso                 CasoCotizacion?
  honorarioMensual     Decimal?        @map("honorario_mensual") @db.Decimal(10, 2)
  implementacionFee    Decimal?        @map("implementacion_fee") @db.Decimal(10, 2)
  breakdown            Json? // [{factor, pts}] desc
  declaracionVeracidad Boolean         @default(false) @map("declaracion_veracidad")
  notaAdicional        String?         @map("nota_adicional") @db.Text
  estado               String          @default("NUEVA") // NUEVA|EN_REVISION|CONVERTIDA|LISTA_ESPERA
  clienteId            String?         @map("cliente_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at")

  tenant  Tenant?  @relation(fields: [tenantId], references: [id])
  cliente Cliente? @relation(fields: [clienteId], references: [id])

  @@index([tenantId])
  @@map("solicitudes_registro")
}

// ════════════════════════════════════════════════════════════
// 11. AGENTE Y AUDITORÍA TRANSVERSAL
// ════════════════════════════════════════════════════════════

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String    @map("actor_id") @db.Uuid
  accion     String
  entidad    String
  entidadId  String    @map("entidad_id") @db.Uuid
  antes      Json?
  despues    Json?
  ip         String?
  userAgent  String?   @map("user_agent")
  hashSha256 String    @map("hash_sha256")
  prevHash   String?   @map("prev_hash")
  chainIndex Int       @default(0) @map("chain_index")
  createdAt  DateTime  @default(now()) @map("created_at")
  // APPEND ONLY — no updatedAt (INV-4)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User   @relation("actor", fields: [actorId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AgenteConversacion {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  titulo    String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  usuario  User            @relation(fields: [usuarioId], references: [id])
  mensajes AgenteMensaje[]

  @@index([tenantId])
  @@map("agente_conversaciones")
}

model AgenteMensaje {
  id             String   @id @default(uuid()) @db.Uuid
  conversacionId String   @map("conversacion_id") @db.Uuid
  rol            String // USER | ASSISTANT | TOOL
  contenido      String   @db.Text
  toolName       String?  @map("tool_name")
  toolInput      Json?    @map("tool_input")
  toolOutput     Json?    @map("tool_output")
  citas          Json? // [{norma_id, identificador, hash}]
  tokensIn       Int?     @map("tokens_in")
  tokensOut      Int?     @map("tokens_out")
  createdAt      DateTime @default(now()) @map("created_at")

  conversacion AgenteConversacion @relation(fields: [conversacionId], references: [id])

  @@map("agente_mensajes")
}

model AgenteActividad {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  fase        Int      @db.SmallInt
  descripcion String
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("agente_actividad")
}

model CorpusChunk {
  id                 String                       @id @default(uuid()) @db.Uuid
  normaId            String?                      @map("norma_id") @db.Uuid
  controlNormativoId String?                      @map("control_normativo_id") @db.Uuid
  contenido          String                       @db.Text
  metadata           Json?
  embedding          Unsupported("vector(1024)")?
  hashSha256         String                       @map("hash_sha256")
  orden              Int                          @default(0)
  encabezado         String?                      @db.Text
  tokens             Int?
  modeloEmbedding    String?                      @map("modelo_embedding")
  dimensiones        Int?
  indexadoAt          DateTime?                   @map("indexado_at")

  norma            Norma?            @relation(fields: [normaId], references: [id])
  controlNormativo ControlNormativo? @relation(fields: [controlNormativoId], references: [id])

  @@index([normaId])
  @@unique([normaId, orden])
  @@map("corpus_chunks")
}

// ════════════════════════════════════════════════════════════
// 12. CORPUS ADMIN — ingesta, extracción, versionado (RN-004)
// ════════════════════════════════════════════════════════════

model NormaFuenteDocumento {
  id               String                @id @default(uuid()) @db.Uuid
  nombreArchivo    String                @map("nombre_archivo")
  mimeType         String                @map("mime_type")
  tamanoBytes      Int                   @map("tamano_bytes")
  storageKey       String                @map("storage_key")
  hashSha256       String                @map("hash_sha256")
  paginas          Int?
  fuente           FuenteNorma
  tipo             TipoNorma
  organismoEmisor  String                @map("organismo_emisor")
  fechaPublicacion DateTime?             @map("fecha_publicacion")
  registroOficial  String?               @map("registro_oficial")
  estado           EstadoDocumentoFuente @default(CARGADO)
  textoPlano       String?               @db.Text @map("texto_plano")
  errorMensaje     String?               @db.Text @map("error_mensaje")
  subidoPorId      String                @map("subido_por_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  articulos ArticuloExtraido[]
  normas    Norma[]
  jobs      JobIngesta[]

  @@map("norma_fuente_documentos")
}

model ArticuloExtraido {
  id                  String                 @id @default(uuid()) @db.Uuid
  documentoId         String                 @map("documento_id") @db.Uuid
  orden               Int
  codigoPropuesto     String                 @map("codigo_propuesto")
  identificador       String
  titulo              String
  categoria           String?
  textoNormativo      String                 @db.Text @map("texto_normativo")
  resumenEjecutivo    String?                @db.Text @map("resumen_ejecutivo")
  fasePHVA            FasePHVA?              @map("fase_phva")
  modulosRelacionados String[]               @map("modulos_relacionados")
  controlesSugeridos  Json?                  @map("controles_sugeridos")
  paginaInicio        Int?                   @map("pagina_inicio")
  offsetInicio        Int?                   @map("offset_inicio")
  offsetFin           Int?                   @map("offset_fin")
  metodoExtraccion    String                 @map("metodo_extraccion")
  confianza           Float?
  fidelidadVerificada Boolean                @default(false) @map("fidelidad_verificada")
  camposGeneradosIA   String[]               @map("campos_generados_ia")
  estado              EstadoArticuloExtraido @default(PROPUESTO)
  revisadoPorId       String?                @map("revisado_por_id") @db.Uuid
  revisadoAt          DateTime?              @map("revisado_at")
  notaRevision        String?                @db.Text @map("nota_revision")

  documento NormaFuenteDocumento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@unique([documentoId, orden])
  @@map("articulos_extraidos")
}

model NormaVersion {
  id               String      @id @default(uuid()) @db.Uuid
  normaId          String      @map("norma_id") @db.Uuid
  version          String
  textoNormativo   String      @db.Text @map("texto_normativo")
  resumenEjecutivo String      @db.Text @map("resumen_ejecutivo")
  estado           EstadoNorma
  hashSha256       String      @map("hash_sha256")
  motivoCambio     String?     @db.Text @map("motivo_cambio")
  creadoPorId      String      @map("creado_por_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at")

  norma Norma @relation(fields: [normaId], references: [id])

  @@unique([normaId, version])
  @@map("norma_versiones")
}

model JobIngesta {
  id            String           @id @default(uuid()) @db.Uuid
  documentoId   String?          @map("documento_id") @db.Uuid
  tipo          String
  estado        EstadoJobIngesta @default(PENDIENTE)
  progreso      Int              @default(0)
  totalItems    Int?             @map("total_items")
  itemsOk       Int              @default(0) @map("items_ok")
  itemsError    Int              @default(0) @map("items_error")
  errorMensaje  String?          @db.Text @map("error_mensaje")
  iniciadoPorId String           @map("iniciado_por_id") @db.Uuid
  startedAt     DateTime?        @map("started_at")
  finishedAt    DateTime?        @map("finished_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  documento NormaFuenteDocumento? @relation(fields: [documentoId], references: [id])

  @@map("jobs_ingesta")
}
