  tenantId        String    @map("tenant_id") @db.Uuid
  tipo            String
  impacto         String // ALTO | BAJO
  faseOrigen      String    @map("fase_origen")
  diagnostico     String    @db.Text
  accionPropuesta String    @map("accion_propuesta") @db.Text
  aplicada        Boolean   @default(false)
  aplicadaAt      DateTime? @map("aplicada_at")

