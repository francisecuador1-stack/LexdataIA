  estado      String    @default("PENDIENTE") // PENDIENTE | FIRMADA | RECHAZADA
  resueltaPor String?   @map("resuelta_por") @db.Uuid
  resueltaAt  DateTime? @map("resuelta_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("solicitudes_firma")
}

