generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ── Multi-tenancy ──────────────────────────────────────────

model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  razonSocial  String
  ruc          String   @unique @db.VarChar(13)
  sector       String
  ciudad       String
  provincia    String
  sitioWeb     String?
  actividadEconomica String?
  representanteLegal String?
  cedulaRepresentante String? @db.VarChar(10)
  direccion    String?
  telefono     String?
  correoInstitucional String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users              User[]
  tratamientos       Tratamiento[]
  activos            Activo[]
  riesgos            Riesgo[]
  controles          Control[]
  hallazgos          Hallazgo[]
  evidencias         Evidencia[]
  incidentes         Incidente[]
  auditorias         Auditoria[]
  recomendaciones    Recomendacion[]
  evaluacionesOrg    EvaluacionOrganizacional[]
  rolesOrg           RolOrganizacional[]
  recursos           RecursoEvaluacion[]
  brechas            Brecha[]
  planesAccion       PlanAccion[]
  principiosEstado   PrincipioEstado[]
  categoriaDatos     CategoriaDatosTenant[]
  evaluacionesEIPD   EvaluacionEIPD[]
  evaluacionesCap    EvaluacionCapacitacion[]
  checklistRespuestas ChecklistRespuesta[]
  diagnosticoPIMS    DiagnosticoPIMS[]
  registroSPDP       RegistroSPDP[]
  auditLogs          AuditLog[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  email     String   @unique
  nombre    String
  rol       Rol
  activo    Boolean  @default(true)
  avatarIniciales String? @db.VarChar(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  evidencias  Evidencia[] @relation("creadoPor")
  auditLogs   AuditLog[]  @relation("actor")

  @@index([tenantId])
  @@map("users")
}

enum Rol {
  SUPERADMIN
  LEGAL_ADMIN
  DPO_HUMANO
  DPO_ANALISTA
  CLIENTE_ADMIN
  CLIENTE_COLABORADOR
  AUDITOR_EXTERNO
  MARK_AI
}

// ── Fase 1: Motor de Conocimiento Normativo ────────────────

model Norma {
  id              String          @id @default(uuid()) @db.Uuid
  fuente          FuenteNormativa
  identificador   String          // "Art. 7", "Res. 2025-0028-R", "ISO 27001:2022 §6.1"
  titulo          String
  categoria       String
  resumen         String          @db.Text
  textoNormativo  String          @db.Text
  fasePHVA        FasePHVA
  estado          EstadoNorma     @default(VIGENTE)
  ambito          Ambito
  organismoEmisor String
  fechaEmision    DateTime
  version         String          @default("1.0")
  hashSha256      String
  createdAt       DateTime        @default(now())

  controlesNormativos ControlNormativo[]
  hallazgos           Hallazgo[]

  // Global: no tenantId — INV-2
  @@unique([fuente, identificador])
  @@map("normas")
}

model ControlNormativo {
  id                String   @id @default(uuid()) @db.Uuid
  normaId           String   @db.Uuid
  titulo            String
  descripcion       String   @db.Text
  evidenciaRequerida String
  fasePHVA          FasePHVA
  hashSha256        String
  createdAt         DateTime @default(now())

  norma Norma @relation(fields: [normaId], references: [id])

  // Global: no tenantId — INV-2
  @@map("controles_normativos")
}

enum FuenteNormativa {
  LOPDP
  RGLOPDP
  CRE
  SPDP
  SGPDP
  ISO_27001
  ISO_27701
  ISO_42001
  NIST
}

enum FasePHVA {
  PLANIFICAR
  HACER
  VERIFICAR
  ACTUAR
}

enum EstadoNorma {
  VIGENTE
  DEROGADA
  MODIFICADA
}

enum Ambito {
  NACIONAL
  INTERNACIONAL
}

// ── Principios Rectores (13) ───────────────────────────────

model PrincipioRector {
  id              String   @id @default(uuid()) @db.Uuid
  nombre          String   @unique
  baseNormativa   String
  definicion      String   @db.Text
  preguntasAuditoria String[] // Array of audit questions

  estados PrincipioEstado[]

  @@map("principios_rectores")
}

model PrincipioEstado {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  principioId   String          @db.Uuid
  estado        EstadoPrincipio @default(PENDIENTE)
  fechaVerificacion DateTime?
  hashSha256    String?
  createdAt     DateTime        @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  principio PrincipioRector @relation(fields: [principioId], references: [id])

  @@unique([tenantId, principioId])
  @@map("principios_estado")
}

enum EstadoPrincipio {
  VERIFICADO
  PENDIENTE
  NO_VERIFICADO
}

// ── Fase 2: Amenazas y Vulnerabilidades ────────────────────

model Tratamiento {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  codigoRAT        String
  nombre           String
  finalidad        String
  baseLegitimacion String?
  retencion        String?
  datosSensibles   Boolean             @default(false)
  categorias       String[]
  estado           EstadoTratamiento   @default(PENDIENTE)
  observacionesDPO String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  riesgos   Riesgo[]
  eipds     EvaluacionEIPD[]
  incidentes Incidente[]

  @@unique([tenantId, codigoRAT])
  @@index([tenantId])
  @@map("tratamientos")
}

enum EstadoTratamiento {
  PENDIENTE
  VALIDADO
  CON_OBSERVACIONES
}

model Activo {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @db.Uuid
  nombre          String
  tipo            String
  criticidad      Criticidad
  responsable     String
  ubicacion       String
  sistemas        String
  datosPersonales Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  riesgos  Riesgo[]
  incidentes Incidente[]

  @@index([tenantId])
  @@map("activos")
}

enum Criticidad {
  ALTA
  MEDIA
  BAJA
}

model CategoriaDatos {
  id             String         @id @default(uuid()) @db.Uuid
  nombre         String         @unique
  baseNormativa  String
  nivel          NivelCategoria
  descripcion    String?

  tenants CategoriaDatosTenant[]

  @@map("categorias_datos")
}

model CategoriaDatosTenant {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  categoriaId  String @db.Uuid
  activo       Boolean @default(false)

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  categoria CategoriaDatos @relation(fields: [categoriaId], references: [id])

  @@unique([tenantId, categoriaId])
  @@map("categorias_datos_tenant")
}

enum NivelCategoria {
  ESTANDAR
  REFORZADO
  MAXIMO
}

model Riesgo {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  tratamientoId   String       @db.Uuid
  activoId        String       @db.Uuid
  amenaza         String       @db.Text
  impacto         Int          @db.SmallInt // 1-5
  probabilidad    Int          @db.SmallInt // 1-5
  score           Int          @db.SmallInt // impacto * probabilidad
  nivel           NivelRiesgo
  estado          EstadoRiesgo @default(IDENTIFICADO)
  revisadoPorDPO  Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  tratamiento  Tratamiento  @relation(fields: [tratamientoId], references: [id])
  activo       Activo       @relation(fields: [activoId], references: [id])

  @@index([tenantId])
  @@index([nivel])
  @@map("riesgos")
}

enum NivelRiesgo {
  BAJO
  MEDIO
  ALTO
  CRITICO
}

enum EstadoRiesgo {
  IDENTIFICADO
  EN_TRATAMIENTO
  MITIGADO
  ACEPTADO
}

model EvaluacionEIPD {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @db.Uuid
  tratamientoId   String      @db.Uuid
  granEscala      Boolean     @default(false)
  datosSensibles  Boolean     @default(false)
  decisionesAuto  Boolean     @default(false)
  perfilamiento   Boolean     @default(false)
  menores         Boolean     @default(false)
  decision        DecisionEIPD @default(PENDIENTE)
  estado          String      @default("Pendiente")
  createdAt       DateTime    @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tratamiento Tratamiento @relation(fields: [tratamientoId], references: [id])

  @@index([tenantId])
  @@map("evaluaciones_eipd")
}

enum DecisionEIPD {
  OBLIGATORIO
  NO_REQUERIDO
  PENDIENTE
}

// ── Fase 3: Implementación ─────────────────────────────────

model EvaluacionOrganizacional {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  dimension   String
  pregunta    String   @db.Text
  baseNormativa String
  respuesta   EstadoEvaluacion?
  esDPO       Boolean  @default(false) // pregunta añadida por DPO
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("evaluaciones_organizacionales")
}

enum EstadoEvaluacion {
  CUMPLE
  PARCIAL
  NO_CUMPLE
}

model RolOrganizacional {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  nombre           String
  baseNormativa    String
  estado           EstadoRolOrg @default(NO_DEFINIDO)
  actaRequerida    Boolean   @default(false)
  hashActa         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("roles_organizacionales")
}

enum EstadoRolOrg {
  DEFINIDO
  PARCIALMENTE_DEFINIDO
  NO_DEFINIDO
}

model RecursoEvaluacion {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  bloque      String        // "Recursos Humanos", "Tecnológicos", etc.
  item        String
  estado      EstadoRecurso @default(NO_EVALUADO)
  createdAt   DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("recursos_evaluacion")
}

enum EstadoRecurso {
  SUFICIENTE
  INSUFICIENTE
  NO_EVALUADO
}

model Brecha {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  codigo      String    // GAP-SIS-0xx
  severidad   Severidad
  descripcion String    @db.Text
  dominio     String
  origen      String    @default("SISTEMA") // SISTEMA | WIZARD
  createdAt   DateTime  @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  planesAccion PlanAccion[]

  @@index([tenantId])
  @@map("brechas")
}

enum Severidad {
  CRITICA
  ALTA
  MEDIA
  BAJA
}

// ── Fase 4-5: Controles ────────────────────────────────────

model Control {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @db.Uuid
  titulo              String
  tipo                TipoControl
  estado              EstadoControl  @default(PROPUESTA)
  baseNormativa       String
  prioridad           Severidad
  plazo               DateTime?
  eficacia            NivelEficacia?
  confianzaEvidencia  NivelEficacia?
  fase                String         @default("F4") // F4 = diseño, F5 = implementación
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  evidencias Evidencia[] @relation("controlEvidencias")

  @@index([tenantId])
  @@map("controles")
}

enum TipoControl {
  TECNICO
  ORGANIZATIVO
  JURIDICO
  DOCUMENTAL
}

enum EstadoControl {
  PROPUESTA
  APROBADA
  EN_IMPLEMENTACION
  IMPLEMENTADO
  PENDIENTE
}

enum NivelEficacia {
  ALTA
  MEDIA
  BAJA
}

// ── Hallazgos (F4 diseño + F5 operativos + F6 auditoría) ──

model Hallazgo {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  codigo       String         // HD-00x, H-00x
  tipo         TipoHallazgo
  descripcion  String         @db.Text
  estado       EstadoHallazgo @default(ABIERTO)
  fase         String         // F4, F5, F6
  normaId      String?        @db.Uuid
  articuloRef  String?
  severidad    Severidad
  documentoAfectado String?
  verificacionEficacia Boolean @default(false)
  hashEvidencia String?
  cerradoPor   String?        @db.Uuid
  fechaCierre  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  norma  Norma? @relation(fields: [normaId], references: [id])

  @@index([tenantId])
  @@index([estado])
  @@map("hallazgos")
}

enum TipoHallazgo {
  NCM  // No Conformidad Mayor
  NCm  // No Conformidad Menor
  OBS  // Observación
  OM   // Oportunidad de Mejora
  BP   // Buena Práctica
}

enum EstadoHallazgo {
  ABIERTO
  EN_PROCESO
  PENDIENTE_EVIDENCIA
  CERRADO
}

// ── Evidencias — Bóveda SHA-256 (INV-3) ────────────────────

model Evidencia {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  nombre         String
  tipo           String   // Documento, Captura de pantalla, Log exportado, Acta, etc.
  hashSha256     String
  prevHash       String?
  archivoUrl     String
  tamano         Int      // bytes
  dimension      String?  // Fase 3 dimension
  controlId      String?  @db.Uuid
  creadoPorId    String   @db.Uuid
  retencionHasta DateTime // created_at + 5 years (INV-3)
  createdAt      DateTime @default(now())

  // Append-only: no updatedAt (INV-3)

  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  creadoPor User    @relation("creadoPor", fields: [creadoPorId], references: [id])
  control   Control? @relation("controlEvidencias", fields: [controlId], references: [id])

  @@index([tenantId])
  @@index([hashSha256])
  @@map("evidencias")
}

// ── Fase 6: Auditoría ──────────────────────────────────────

model Auditoria {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  codigo      String          // AUD-2026-01
  tipo        TipoAuditoria
  estado      EstadoAuditoria @default(PROGRAMADA)
  objetivo    String          @db.Text
  responsable String
  fecha       DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("auditorias")
}

enum TipoAuditoria {
  INTERNA
  EXTERNA
}

enum EstadoAuditoria {
  PROGRAMADA
  EN_EJECUCION
  CERRADA
}

// ── Incidentes — Reloj 72h (INV-9) ────────────────────────

model Incidente {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @db.Uuid
  codigo              String           // INC-2026-001
  tipo                TipoIncidente
  estado              EstadoIncidente  @default(DETECTADO)
  descripcion         String           @db.Text
  activoId            String?          @db.Uuid
  tratamientoId       String?          @db.Uuid
  fechaDeteccion      DateTime
  fechaMaxReporteSPDP DateTime         // fechaDeteccion + 72h (INV-9)
  notificadoSPDP      Boolean          @default(false)
  fechaNotificacion   DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  activo      Activo?      @relation(fields: [activoId], references: [id])
  tratamiento Tratamiento? @relation(fields: [tratamientoId], references: [id])

  @@index([tenantId])
  @@index([notificadoSPDP])
  @@map("incidentes")
}

enum TipoIncidente {
  CONFIDENCIALIDAD
  INTEGRIDAD
  DISPONIBILIDAD
}

enum EstadoIncidente {
  DETECTADO
  EN_INVESTIGACION
  NOTIFICADO_SPDP
  CERRADO
}

// ── Fase 7: Mejora Continua ────────────────────────────────

model Recomendacion {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @db.Uuid
  codigo              String               // REC-2026-00x
  titulo              String
  descripcion         String               @db.Text
  estado              EstadoRecomendacion  @default(EMITIDA)
  responsable         String
  plazo               DateTime
  dominio             String?
  prioridad           Severidad            @default(ALTA)
  verificadoPorId     String?              @db.Uuid
  fechaVerificacion   DateTime?
  hashEvidencia       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("recomendaciones")
}

enum EstadoRecomendacion {
  EMITIDA
  EN_IMPLEMENTACION
  IMPLEMENTADA
  CERRADA
}

model PlanAccion {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  titulo       String
  estado       EstadoPlanAccion @default(COMPROMETIDO)
  brechaId     String?  @db.Uuid
  responsable  String
  plazo        DateTime
  hashEvidencia String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  brecha Brecha? @relation(fields: [brechaId], references: [id])

  @@index([tenantId])
  @@map("planes_accion")
}

enum EstadoPlanAccion {
  COMPROMETIDO
  EN_EJECUCION
  COMPLETADO
  VENCIDO
}

// ── Checklist Inteligente (RN-603) ─────────────────────────

model ChecklistPregunta {
  id          String   @id @default(uuid()) @db.Uuid
  perfil      String   // LOPDP, ISO_27701, VIDEOVIGILANCIA, SALUD, IA
  pregunta    String   @db.Text
  articuloRef String
  orden       Int

  respuestas ChecklistRespuesta[]

  @@map("checklist_preguntas")
}

model ChecklistRespuesta {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @db.Uuid
  preguntaId String            @db.Uuid
  respuesta  RespuestaChecklist
  createdAt  DateTime          @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  pregunta ChecklistPregunta @relation(fields: [preguntaId], references: [id])

  @@unique([tenantId, preguntaId])
  @@map("checklist_respuestas")
}

enum RespuestaChecklist {
  CUMPLE
  NO_CUMPLE
  PARCIAL
  NO_APLICA
}

// ── Capacitaciones ─────────────────────────────────────────

model CapacitacionModulo {
  id               String   @id @default(uuid()) @db.Uuid
  titulo           String
  nivel            NivelCapacitacion
  categoria        String
  baseNormativa    String
  duracionMinutos  Int
  descripcion      String   @db.Text
  orden            Int      @default(0)

  evaluaciones EvaluacionCapacitacion[]

  @@map("capacitacion_modulos")
}

enum NivelCapacitacion {
  BASICO
  INTERMEDIO
  AVANZADO
}

model EvaluacionCapacitacion {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @db.Uuid
  userId   String   @db.Uuid
  moduloId String   @db.Uuid
  puntaje  Int      @db.SmallInt // 0-100
  aprobado Boolean  // puntaje >= 70 (RN-801)
  fecha    DateTime @default(now())

  tenant Tenant             @relation(fields: [tenantId], references: [id])
  modulo CapacitacionModulo @relation(fields: [moduloId], references: [id])

  @@index([tenantId])
  @@map("evaluaciones_capacitacion")
}

// ── Portal del Cliente ─────────────────────────────────────

model DiagnosticoPIMS {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  modulo     Int          @db.SmallInt // 0-10
  pregunta   Int          @db.SmallInt // 1-3
  respuesta  RespuestaPIMS?
  createdAt  DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, modulo, pregunta])
  @@index([tenantId])
  @@map("diagnostico_pims")
}

enum RespuestaPIMS {
  IMPLEMENTADO
  EN_PROCESO
  NO_IMPLEMENTADO
}

// ── Formulario SPDP + Pd-VaR ──────────────────────────────

model RegistroSPDP {
  id                         String   @id @default(uuid()) @db.Uuid
  tenantId                   String   @db.Uuid
  // S1
  sector                     String?
  trabajadores               String?
  sucursales                 String?
  // S2
  volumenRegistros           String?
  categoriasTitulares        String[]
  // S3
  datosSalud                 Boolean  @default(false)
  datosBiometricos           Boolean  @default(false)
  datosGeneticos             Boolean  @default(false)
  datosMenores               Boolean  @default(false)
  datosRaciales              Boolean  @default(false)
  datosPoliticos             Boolean  @default(false)
  datosReligiosos            Boolean  @default(false)
  datosSindicales            Boolean  @default(false)
  datosSexuales              Boolean  @default(false)
  datosPenales               Boolean  @default(false)
  descripcionSensibles       String?  @db.Text
  // S4
  usaIA                      Boolean  @default(false)
  decisionesAutomatizadas    Boolean  @default(false)
  realizaPerfilamiento       Boolean  @default(false)
  transferenciasInternacionales Boolean @default(false)
  cloudExtranjero            Boolean  @default(false)
  sistemasTecnologicos       String?  @db.Text
  // S5
  tieneRAT                   Boolean  @default(false)
  tieneEIPD                  Boolean  @default(false)
  tieneLIA                   Boolean  @default(false)
  tienePoliticas             Boolean  @default(false)
  tieneDPO                   Boolean  @default(false)
  // S6
  solicitudesARCO            String?
  incidentesAnuales          String?
  canalArco                  String?
  responsableArco            String?
  verificacion               String?
  // S7
  compromisoDirectivo        Boolean  @default(false)
  comitePrivacidad           Boolean  @default(false)
  antecedentesReclamos       Boolean  @default(false)
  sancionesSPDP              Boolean  @default(false)
  declaracionVeracidad       Boolean  @default(false)
  notaAdicional              String?  @db.Text
  // Resultado Pd-VaR
  pdScore                    Int?
  nivelRiesgo                String?
  caso                       String?  @db.VarChar(1) // A or B
  honorarioMensual           Int?
  completado                 Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("registros_spdp")
}

// ── Audit Log — Cadena de hash (INV-4) ─────────────────────

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  actorType  ActorType
  actorId    String    @db.Uuid
  accion     String
  entidad    String
  entidadId  String    @db.Uuid
  detalle    String    @db.Text
  hashSha256 String
  prevHash   String?
  createdAt  DateTime  @default(now())

  // Append-only: no updatedAt (INV-4)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User   @relation("actor", fields: [actorId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum ActorType {
  HUMANO
  MARK_AI
  SISTEMA
}
