  notificadoSpdp       Boolean         @default(false) @map("notificado_spdp")
  fechaNotificacion    DateTime?       @map("fecha_notificacion")
  titularesComunicados Boolean         @default(false) @map("titulares_comunicados")
  estado               EstadoIncidente @default(DETECTADO)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  tratamiento Tratamiento? @relation(fields: [tratamientoId], references: [id])
  activo      Activo?      @relation(fields: [activoId], references: [id])

  @@index([tenantId])
  @@index([notificadoSpdp])
  @@map("incidentes")
}

