generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

// ════════════════════════════════════════════════════════════
// 1. ENUMS
// ════════════════════════════════════════════════════════════

enum FasePHVA {
  PLANIFICAR
  HACER
  VERIFICAR
  ACTUAR
}

enum TipoNorma {
  NACIONAL
  INTERNACIONAL
}

enum FuenteNorma {
  CRE
  LOPDP
  RGLOPDP
  SPDP
  SGPDP
  ISO_27001
  ISO_27701
  ISO_42001
  NIST
}

enum EstadoNorma {
  VIGENTE
  DEROGADA
  PROYECTO
}

enum EstadoPrincipio {
  VERIFICADO
  PENDIENTE
  NO_VERIFICADO
}

enum EstadoTratamiento {
  PENDIENTE
  VALIDADO
  CON_OBSERVACIONES
}

enum NivelRiesgo {
  BAJO
  MEDIO
  ALTO
  CRITICO
}

enum EstadoRiesgo {
  IDENTIFICADO
  EN_TRATAMIENTO
  MITIGADO
  ACEPTADO
}

enum NivelCategoriaDatos {
  ESTANDAR
  REFORZADO
  MAXIMO
  MAXIMO_REPRESENTANTE
}

enum CriticidadActivo {
  BAJA
  MEDIA
  ALTA
}

enum TipoControl {
  TECNICO
  ORGANIZATIVO
  LEGAL
  DOCUMENTAL
}

enum EstadoControl {
  PROPUESTA
  APROBADA
  EN_IMPLEMENTACION
  IMPLEMENTADO
  EN_PROGRESO
  PENDIENTE
}

enum Eficacia {
  ALTA
  MEDIA
  BAJA
  NO_EVALUADA
}

enum Confianza {
  ALTA
  MEDIA
  BAJA
  NO_EVALUADA
}

enum Suficiencia {
  SUFICIENTE
  PROPORCIONAL
  INSUFICIENTE
  NO_EVALUADA
}

enum TipoHallazgo {
  NC_MAYOR
  NC_MENOR
  OBSERVACION
  OPORTUNIDAD
  BUENA_PRACTICA
  HALLAZGO_DISENO
}

enum SeveridadHallazgo {
  CRITICA
  MAYOR
  MENOR
}

enum EstadoHallazgo {
  ABIERTO
  EN_PROCESO
  PENDIENTE_EVIDENCIA
  CERRADO
  NO_RESUELTO
}

enum EstadoAuditoria {
  PROGRAMADA
  EN_EJECUCION
  CERRADA
}

enum TipoAuditoria {
  INTERNA
  EXTERNA
}

enum RespuestaChecklist {
  CUMPLE
  NO_CUMPLE
  PARCIAL
  NO_APLICA
}

enum PerfilChecklist {
  LOPDP
  ISO_27701
  VIDEOVIGILANCIA
  SALUD_SENSIBLES
  INTELIGENCIA_ARTIFICIAL
}

enum TipoIncidente {
  CONFIDENCIALIDAD
  INTEGRIDAD
  DISPONIBILIDAD
}

enum EstadoIncidente {
  DETECTADO
  EN_CONTENCION
  NOTIFICADO_SPDP
  CERRADO
}

enum EstadoRecomendacion {
  EMITIDA
  PENDIENTE
  EN_PROCESO
  EN_IMPLEMENTACION
  IMPLEMENTADA
  VERIFICADO
  CERRADA
}

enum EstadoPlanAccion {
  COMPROMETIDO
  EN_EJECUCION
  COMPLETADO
  VENCIDO
}

enum NivelMadurez {
  INICIAL
  GESTIONADO
  DEFINIDO
  CONTROLADO
  OPTIMIZADO
}

enum RespuestaDiagnostico {
  CUMPLE
  PARCIAL
  NO_CUMPLE
}

enum RespuestaPIMS {
  IMPLEMENTADO
  EN_PROCESO
  NO_IMPLEMENTADO
}

enum EstadoRol {
  DEFINIDO
  PARCIALMENTE_DEFINIDO
  NO_DEFINIDO
}

enum EstadoRecurso {
  SUFICIENTE
  INSUFICIENTE
  NO_EVALUADO
}

enum Rol {
  SUPERADMIN
  LEGAL_ADMIN
  DPO_HUMANO
  DPO_ANALISTA
  CLIENTE_ADMIN
  CLIENTE_COLABORADOR
  AUDITOR_EXTERNO
  MARK_AI
}

enum ActorType {
  HUMANO
  MARK_AI
  SISTEMA
}

enum CasoCotizacion {
  A
  B
}

enum EstadoDocumentoFuente {
  CARGADO
  EXTRAYENDO
  EXTRAIDO
  EN_REVISION
  PUBLICADO
  RECHAZADO
  ERROR
}

enum EstadoArticuloExtraido {
  PROPUESTO
  EDITADO
  APROBADO
  DESCARTADO
}

enum EstadoJobIngesta {
  PENDIENTE
  EJECUTANDO
  COMPLETADO
  FALLIDO
}

// ════════════════════════════════════════════════════════════
// 2. NÚCLEO: tenant, usuarios, empresa cliente
// ════════════════════════════════════════════════════════════

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String
  plan      String   @default("standard")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  usuarios               User[]
  clientes               Cliente[]
  tratamientos           Tratamiento[]
  activos                Activo[]
  riesgos                Riesgo[]
  controles              Control[]
  medidas                Medida[]
  hallazgos              Hallazgo[]
  evidencias             Evidencia[]
  documentos             Documento[]
  firmas                 Firma[]
  solicitudesFirma       SolicitudFirma[]
  incidentes             Incidente[]
  auditorias             Auditoria[]
  revisionesTecnicas     RevisionTecnica[]
  checklistRespuestas    ChecklistRespuesta[]
  recomendaciones        Recomendacion[]
  accionesCorrectivas    AccionCorrectiva[]
  planesAccion           PlanAccion[]
  brechas                Brecha[]
  diagnosticoRespuestas  DiagnosticoRespuesta[]
  gobiernoItems          GobiernoItem[]
  rolesSgpdp             RolSgpdp[]
  recursosEvaluacion     RecursoEvaluacion[]
  validacionesPrincipios ValidacionPrincipio[]
  principiosEstado       PrincipioEstado[]
  categoriaDatosTenant   CategoriaDatosTenant[]
  evaluacionesEipd       EvaluacionEipd[]
  procesos               Proceso[]
  solicitudesArco        SolicitudArco[]
  kpiSnapshots           KpiSnapshot[]
  madurezSnapshots       MadurezSnapshot[]
  lecciones              Leccion[]
  oportunidadesMejora    OportunidadMejora[]
  inscripciones          Inscripcion[]
  evaluacionesCap        Evaluacion[]
  certificados           Certificado[]
  pimsRespuestas         PimsRespuesta[]
  solicitudesRegistro    SolicitudRegistro[]
  auditLogs              AuditLog[]
  agenteConversaciones   AgenteConversacion[]
  agenteActividad        AgenteActividad[]
  normaFavoritas         NormaFavorita[]
  normaVistas            NormaVista[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String    @unique
  nombre       String
  rol          Rol
  passwordHash String    @map("password_hash")
  mfaSecret    String?   @map("mfa_secret")
  mfaEnabled   Boolean   @default(false) @map("mfa_enabled")
  ultimoAcceso DateTime? @map("ultimo_acceso")
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  evidenciasCargadas   Evidencia[]          @relation("creadoPor")
  auditLogs            AuditLog[]           @relation("actor")
  firmas               Firma[]
  normaFavoritas       NormaFavorita[]
  normaVistas          NormaVista[]
  agenteConversaciones AgenteConversacion[]

  @@index([tenantId])
  @@map("usuarios")
}

model Cliente {
  id                         String       @id @default(uuid()) @db.Uuid
  tenantId                   String       @map("tenant_id") @db.Uuid
  razonSocial                String       @map("razon_social")
  ruc                        String       @unique @db.VarChar(13)
  actividadEconomica         String?      @map("actividad_economica")
  sector                     String?
  representanteLegal         String?      @map("representante_legal")
  cedulaRepresentante        String?      @map("cedula_representante") @db.VarChar(10)
  direccion                  String?
  ciudad                     String?
  provincia                  String?
  telefono                   String?
  email                      String?
  sitioWeb                   String?      @map("sitio_web")
  empleados                  String?
  transferenciaInternacional Boolean      @default(false) @map("transferencia_internacional")
  paisesDestino              String[]     @map("paises_destino")
  encargadoExterno           Boolean      @default(false) @map("encargado_externo")
  nombreEncargado            String?      @map("nombre_encargado")
  trataDatosSensibles        Boolean      @default(false) @map("trata_datos_sensibles")
  tiposDatosSensibles        String[]     @map("tipos_datos_sensibles")
  decisionesAutomatizadas    Boolean      @default(false) @map("decisiones_automatizadas")
  perfilamiento              Boolean      @default(false)
  videovigilancia            Boolean      @default(false)
  menoresEdad                Boolean      @default(false) @map("menores_edad")
  dpiaRealizada              Boolean      @default(false) @map("dpia_realizada")
  brechaPreviaReportada      Boolean      @default(false) @map("brecha_previa_reportada")
  fechaFormulario            DateTime?    @map("fecha_formulario")
  nivelRiesgo                NivelRiesgo? @map("nivel_riesgo")
  pdScore                    Int?         @map("pd_score")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  solicitudesRegistro SolicitudRegistro[]
  tratamientos        Tratamiento[]
  activos             Activo[]

  @@index([tenantId])
  @@map("clientes")
}

// ════════════════════════════════════════════════════════════
// 3. CORPUS NORMATIVO (RN-004, read-only para operadores)
// ════════════════════════════════════════════════════════════

model Norma {
  id                  String                       @id @default(uuid()) @db.Uuid
  codigo              String                       @unique // "LOPDP-ART-7", "ISO27001-6.1"
  fuente              FuenteNorma
  tipo                TipoNorma
  identificador       String // "Art. 7", "§6.1"
  titulo              String
  categoria           String
  resumenEjecutivo    String                       @map("resumen_ejecutivo") @db.Text
  textoNormativo      String                       @map("texto_normativo") @db.Text
  organismoEmisor     String                       @map("organismo_emisor")
  fechaEmision        DateTime                     @map("fecha_emision")
  version             String                       @default("1.0")
  estado              EstadoNorma                  @default(VIGENTE)
  fasePHVA            FasePHVA                     @map("fase_phva")
  hashSha256          String                       @map("hash_sha256")
  modulosRelacionados String[]                     @map("modulos_relacionados")
  embedding           Unsupported("vector(1024)")?
  textoVerificado     Boolean                      @default(false) @map("texto_verificado")
  fuenteDocumentoId   String?                      @map("fuente_documento_id") @db.Uuid
  indexadoAt          DateTime?                    @map("indexado_at")
  modeloEmbedding     String?                      @map("modelo_embedding")
  createdAt           DateTime                     @default(now()) @map("created_at")

  controlesNormativos ControlNormativo[]
  hallazgos           Hallazgo[]
  procesoNormas       ProcesoNorma[]
  normaFavoritas      NormaFavorita[]
  normaVistas         NormaVista[]
  controles           Control[]
  corpusChunks        CorpusChunk[]
  fuenteDocumento     NormaFuenteDocumento? @relation(fields: [fuenteDocumentoId], references: [id])
  versiones           NormaVersion[]

  @@unique([fuente, identificador])
  @@map("normas")
}

model ControlNormativo {
  id                 String   @id @default(uuid()) @db.Uuid
  normaId            String   @map("norma_id") @db.Uuid
  titulo             String
  descripcion        String   @db.Text
  evidenciaRequerida String   @map("evidencia_requerida")
  fasePHVA           FasePHVA @map("fase_phva")
  hashSha256         String   @map("hash_sha256")
  createdAt          DateTime @default(now()) @map("created_at")

  norma        Norma         @relation(fields: [normaId], references: [id])
  corpusChunks CorpusChunk[]

  @@map("controles_normativos")
}

model PrincipioRector {
  id            String @id @default(uuid()) @db.Uuid
  nombre        String @unique
  baseNormativa String @map("base_normativa")
  definicion    String @db.Text
  orden         Int

  preguntas PrincipioPreguntaAuditoria[]
  estados   PrincipioEstado[]

  @@map("principios_rectores")
}

model PrincipioPreguntaAuditoria {
  id          String @id @default(uuid()) @db.Uuid
  principioId String @map("principio_id") @db.Uuid
  orden       Int
  pregunta    String @db.Text

  principio PrincipioRector @relation(fields: [principioId], references: [id])

  @@map("principio_preguntas_auditoria")
}

model PrincipioEstado {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  principioId   String          @map("principio_id") @db.Uuid
  estado        EstadoPrincipio @default(PENDIENTE)
  verificadoAt  DateTime?       @map("verificado_at")
  verificadoPor String?         @map("verificado_por") @db.Uuid
  hashEvidencia String?         @map("hash_evidencia")
  createdAt     DateTime        @default(now()) @map("created_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  principio PrincipioRector @relation(fields: [principioId], references: [id])

  @@unique([tenantId, principioId])
  @@map("principios_estado")
}

model NormaFavorita {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  usuarioId String @map("usuario_id") @db.Uuid
  normaId   String @map("norma_id") @db.Uuid

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  usuario User   @relation(fields: [usuarioId], references: [id])
  norma   Norma  @relation(fields: [normaId], references: [id])

  @@unique([tenantId, usuarioId, normaId])
  @@map("norma_favoritas")
}

model NormaVista {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  normaId   String   @map("norma_id") @db.Uuid
  vistoAt   DateTime @default(now()) @map("visto_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  usuario User   @relation(fields: [usuarioId], references: [id])
  norma   Norma  @relation(fields: [normaId], references: [id])

  @@map("norma_vistas")
}

// ════════════════════════════════════════════════════════════
// 4. FASE 2 — INVENTARIO Y RIESGOS
// ════════════════════════════════════════════════════════════

model Proceso {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  nombre   String
  nivel    String // macroproceso, proceso, subproceso
  estado   String  @default("PENDIENTE") // IMPLEMENTADO, EN_PROGRESO, PENDIENTE

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  parent Proceso?       @relation("procesoHijos", fields: [parentId], references: [id])
  hijos  Proceso[]      @relation("procesoHijos")
  normas ProcesoNorma[]

  @@index([tenantId])
  @@map("procesos")
}

model ProcesoNorma {
  id        String @id @default(uuid()) @db.Uuid
  procesoId String @map("proceso_id") @db.Uuid
  normaId   String @map("norma_id") @db.Uuid

  proceso Proceso @relation(fields: [procesoId], references: [id])
  norma   Norma   @relation(fields: [normaId], references: [id])

  @@unique([procesoId, normaId])
  @@map("proceso_normas")
}

model Tratamiento {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  clienteId        String?           @map("cliente_id") @db.Uuid
  codigoRat        String            @map("codigo_rat")
  nombre           String
  finalidad        String
  baseLegal        String?           @map("base_legal")
  categorias       String[]
  datosSensibles   Boolean           @default(false) @map("datos_sensibles")
  retencion        String?
  area             String?
  estado           EstadoTratamiento @default(PENDIENTE)
  observacionesDpo String?           @map("observaciones_dpo") @db.Text
  validadoPor      String?           @map("validado_por") @db.Uuid
  validadoAt       DateTime?         @map("validado_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  tenant            Tenant                @relation(fields: [tenantId], references: [id])
  cliente           Cliente?              @relation(fields: [clienteId], references: [id])
  riesgos           Riesgo[]
  evaluacionesEipd  EvaluacionEipd[]
  incidentes        Incidente[]
  activos           TratamientoActivo[]
  validacionesPrinc ValidacionPrincipio[]
  solicitudesArco   SolicitudArco[]

  @@unique([tenantId, codigoRat])
  @@index([tenantId])
  @@index([clienteId])
  @@map("tratamientos")
}

model Activo {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  clienteId          String?          @map("cliente_id") @db.Uuid
  nombre             String
  tipo               String
  criticidad         CriticidadActivo
  responsable        String
  ubicacion          String
  sistemas           String[]
  contienePersonales Boolean          @default(true) @map("contiene_personales")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  cliente      Cliente?            @relation(fields: [clienteId], references: [id])
  riesgos      Riesgo[]
  incidentes   Incidente[]
  tratamientos TratamientoActivo[]

  @@index([tenantId])
  @@index([clienteId])
  @@map("activos")
}

model TratamientoActivo {
  id            String @id @default(uuid()) @db.Uuid
  tratamientoId String @map("tratamiento_id") @db.Uuid
  activoId      String @map("activo_id") @db.Uuid

  tratamiento Tratamiento @relation(fields: [tratamientoId], references: [id])
  activo      Activo      @relation(fields: [activoId], references: [id])

  @@unique([tratamientoId, activoId])
  @@map("tratamiento_activos")
}

model CategoriaDatos {
  id            String              @id @default(uuid()) @db.Uuid
  nombre        String              @unique
  baseNormativa String              @map("base_normativa")
  nivel         NivelCategoriaDatos
  descripcion   String?

  tenants CategoriaDatosTenant[]

  @@map("categorias_datos")
}

model CategoriaDatosTenant {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  categoriaId String  @map("categoria_id") @db.Uuid
  activa      Boolean @default(false)

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  categoria CategoriaDatos @relation(fields: [categoriaId], references: [id])

  @@unique([tenantId, categoriaId])
  @@map("categorias_datos_tenant")
}

model Amenaza {
  id               String @id @default(uuid()) @db.Uuid
  familia          String
  nombre           String
  descripcion      String @db.Text
  probabilidadBase Int    @map("probabilidad_base") @db.SmallInt // 1..5

  vulnerabilidades Vulnerabilidad[]
  riesgos          Riesgo[]

  @@map("amenazas")
}

model Vulnerabilidad {
  id        String @id @default(uuid()) @db.Uuid
  amenazaId String @map("amenaza_id") @db.Uuid
  nombre    String

  amenaza Amenaza @relation(fields: [amenazaId], references: [id])

  @@map("vulnerabilidades")
}

model Riesgo {
  id                  String       @id @default(uuid()) @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  tratamientoId       String       @map("tratamiento_id") @db.Uuid
  activoId            String       @map("activo_id") @db.Uuid
  amenazaId           String?      @map("amenaza_id") @db.Uuid
  vulnerabilidadTexto String?      @map("vulnerabilidad_texto")
  impacto             Int          @db.SmallInt
  probabilidad        Int          @db.SmallInt
  score               Int          @db.SmallInt // impacto * probabilidad
  nivel               NivelRiesgo
  estado              EstadoRiesgo @default(IDENTIFICADO)
  requiereEipd        Boolean      @default(false) @map("requiere_eipd")
  revisadoDpo         Boolean      @default(false) @map("revisado_dpo")
  revisadoAt          DateTime?    @map("revisado_at")
  riesgoResidual      Int?         @map("riesgo_residual") @db.SmallInt
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tratamiento Tratamiento @relation(fields: [tratamientoId], references: [id])
  activo      Activo      @relation(fields: [activoId], references: [id])
  amenaza     Amenaza?    @relation(fields: [amenazaId], references: [id])

  @@index([tenantId])
  @@index([nivel])
  @@map("riesgos")
}

model EvaluacionEipd {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  tratamientoId      String   @map("tratamiento_id") @db.Uuid
  tipo               String   @default("EIPD") // EIPD | LIA
  granEscala         Boolean  @default(false) @map("gran_escala")
  sensibles          Boolean  @default(false)
  decisionesAuto     Boolean  @default(false) @map("decisiones_auto")
  perfilamiento      Boolean  @default(false)
  menores            Boolean  @default(false)
  puntajeMtge        Int?     @map("puntaje_mtge") @db.SmallInt
  decision           String   @default("OBLIGATORIO") // OBLIGATORIO | NO_OBLIGATORIO
  estado             String   @default("Pendiente")
  informeDocumentoId String?  @map("informe_documento_id") @db.Uuid
  firmadoPor         String?  @map("firmado_por") @db.Uuid
  hashSha256         String?  @map("hash_sha256")
  createdAt          DateTime @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tratamiento Tratamiento @relation(fields: [tratamientoId], references: [id])

  @@index([tenantId])
  @@map("evaluaciones_eipd")
}

// ════════════════════════════════════════════════════════════
// 5. FASES 3 Y 4 — DIAGNÓSTICO, GOBIERNO, CONTROLES
// ════════════════════════════════════════════════════════════

model DiagnosticoDimension {
  id     String @id @default(uuid()) @db.Uuid
  nombre String @unique
  orden  Int

  preguntas DiagnosticoPregunta[]

  @@map("diagnostico_dimensiones")
}

model DiagnosticoPregunta {
  id            String  @id @default(uuid()) @db.Uuid
  dimensionId   String  @map("dimension_id") @db.Uuid
  orden         Int
  enunciado     String  @db.Text
  baseNormativa String  @map("base_normativa")
  creadaPorDpo  Boolean @default(false) @map("creada_por_dpo")
