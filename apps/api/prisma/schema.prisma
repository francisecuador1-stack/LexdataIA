model Hallazgo {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  codigo              String
  tipo                TipoHallazgo
  severidad           SeveridadHallazgo
  descripcion         String            @db.Text
  normaId             String?           @map("norma_id") @db.Uuid // RN-601: obligatorio
  documentoAfectado   String?           @map("documento_afectado")
  faseOrigen          Int?              @map("fase_origen") @db.SmallInt
  auditoriaId         String?           @map("auditoria_id") @db.Uuid
  estado              EstadoHallazgo    @default(ABIERTO)
  detectadoAt         DateTime          @default(now()) @map("detectado_at")
  cerradoPor          String?           @map("cerrado_por") @db.Uuid
  cerradoAt           DateTime?         @map("cerrado_at")
  hashEvidenciaCierre String?           @map("hash_evidencia_cierre")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  norma           Norma?          @relation(fields: [normaId], references: [id])
  auditoria       Auditoria?      @relation(fields: [auditoriaId], references: [id])
  recomendaciones Recomendacion[]

  @@index([tenantId])
  @@index([estado])
  @@map("hallazgos")
}

model Incidente {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  codigo               String
  tipo                 TipoIncidente
  tratamientoId        String?         @map("tratamiento_id") @db.Uuid
  activoId             String?         @map("activo_id") @db.Uuid
  descripcion          String          @db.Text
  fechaDeteccion       DateTime        @map("fecha_deteccion")
