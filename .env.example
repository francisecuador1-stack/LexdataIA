# ══════════════════════════════════════════════════════════
# Supabase — three connections (INV-11)
# ══════════════════════════════════════════════════════════

# Pooler (transaction mode) — used by Prisma for all app queries.
# Role: lexdata_app (NOBYPASSRLS). RLS enforced via SET LOCAL request.jwt.claims.
DATABASE_URL="postgresql://lexdata_app.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection — used only by Prisma for migrations (`prisma migrate`).
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# System/privileged connection — used only by SystemDbService for tenant admin.
# Role: postgres. NEVER exposed to request handlers. (INV-11)
SYSTEM_DB_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase project keys (for Storage SDK)
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ══════════════════════════════════════════════════════════
# Redis (BullMQ)
# ══════════════════════════════════════════════════════════
REDIS_URL="redis://localhost:6379"

# ══════════════════════════════════════════════════════════
# Anthropic (MARK AI)
# ══════════════════════════════════════════════════════════
ANTHROPIC_API_KEY="sk-ant-..."

# ══════════════════════════════════════════════════════════
# App
# ══════════════════════════════════════════════════════════
API_PORT=3001
WEB_PORT=5173
JWT_SECRET="change-me-in-production"
