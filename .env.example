# ══════════════════════════════════════════════════════════
# Supabase — three connections (INV-11)
# ══════════════════════════════════════════════════════════
#
# The API uses THREE separate database connections, each with a different
# role and purpose. This separation enforces the principle of least privilege
# and ensures RLS cannot be bypassed by application code.
#
# 1. DATABASE_URL — connects as `lexdata_app` (NOBYPASSRLS).
#    This is the role used by the API for ALL business queries.
#    RLS is enforced via `SET LOCAL request.jwt.claims` on every request.
#    Routed through PgBouncer in transaction mode.
#
# 2. DIRECT_URL — connects directly (no pooler) for Prisma
#    introspection and client generation only (`prisma generate`,
#    `prisma db pull`). Not used at runtime.
#
# 3. SYSTEM_DB_URL — connects as `postgres` (superuser).
#    ONLY used inside SystemDbService for tenant administration
#    (creating schemas, seeding catalog data, managing roles).
#    NEVER exposed to request handlers or business logic.
#
# ══════════════════════════════════════════════════════════

# Pooler (transaction mode) — role: lexdata_app (NOBYPASSRLS)
DATABASE_URL="postgresql://lexdata_app:password@localhost:54322/postgres?pgbouncer=true"

# Direct connection — for Prisma introspection/generation only
DIRECT_URL="postgresql://postgres:password@localhost:54322/postgres"

# System/privileged connection — role: postgres — ONLY for SystemDbService (INV-11)
SYSTEM_DB_URL="postgresql://postgres:password@localhost:54322/postgres"

# Supabase project keys (for Storage SDK)
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ══════════════════════════════════════════════════════════
# Redis (BullMQ)
# ══════════════════════════════════════════════════════════
REDIS_URL="redis://localhost:6379"

# ══════════════════════════════════════════════════════════
# Anthropic (MARK AI)
# ══════════════════════════════════════════════════════════
ANTHROPIC_API_KEY="sk-ant-..."

# ══════════════════════════════════════════════════════════
# Embeddings (Voyage AI — corpus semántico)
# ══════════════════════════════════════════════════════════
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_MODEL=voyage-law-2
EMBEDDINGS_DIM=1024
VOYAGE_API_KEY=
EMBEDDINGS_BATCH_SIZE=128

# ══════════════════════════════════════════════════════════
# Corpus ingestion
# ══════════════════════════════════════════════════════════
CORPUS_STORAGE_BUCKET=corpus-fuentes
CORPUS_MAX_UPLOAD_MB=50
CORPUS_OCR_ENABLED=true

# ══════════════════════════════════════════════════════════
# App
# ══════════════════════════════════════════════════════════
API_PORT=3001
WEB_PORT=5173
JWT_SECRET="change-me-in-production"
